# Configuration locale et déploiement : aucun secret dans NEXT_PUBLIC_*.
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Supabase Staging — les clés définitives seront choisies avec le lot Auth.
SUPABASE_STAGING_URL=https://staging-example.supabase.co
SUPABASE_STAGING_ANON_KEY=replace-with-staging-anon-key

# Supabase Production : futur accès serveur en lecture restreinte pour les statistiques.
SUPABASE_PRODUCTION_URL=https://production-example.supabase.co
SUPABASE_PRODUCTION_READONLY_KEY=replace-with-server-only-readonly-credential

# Publication : capacité serveur distincte et limitée à public.exercises.
SUPABASE_PRODUCTION_PUBLISH_URL=https://production-example.supabase.co
SUPABASE_PRODUCTION_PUBLISH_KEY=replace-with-server-only-publish-credential

# NovLearn Exercise Engine — configuration à préciser lors de son intégration.
EXERCISE_ENGINE_PACKAGE=novlearn-exercise-engine

# Déploiement : à adapter à l'hébergeur retenu.
DEPLOYMENT_ENVIRONMENT=local
