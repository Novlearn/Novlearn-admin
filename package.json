{
  "name": "novlearn-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-auth.mjs",
    "dev": "next dev",
    "predev": "node scripts/prepare-mathlive.mjs",
    "build": "next build",
    "prebuild": "node scripts/prepare-mathlive.mjs",
    "test:math-input:browser": "node scripts/math-input-browser.mjs",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run test && npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:smoke"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.5",
    "postcss-selector-parser": "7.1.6"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "mathlive": "0.111.1",
    "next": "15.5.27",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@types/node": "22.19.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.30",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
