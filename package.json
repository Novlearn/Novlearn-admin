  },
  "dependencies": {
    "next": "15.5.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@types/node": "22.19.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.22",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.12",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3"
  }
}
