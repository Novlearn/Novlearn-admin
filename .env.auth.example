# Complément de .env.example. Activation Staging seulement après revue explicite.
# D12 autorise le raccordement qualifié ; voir .env.vercel.example pour Vercel.
ADMIN_STAGING_AUTH_ENABLED=false
# Référence de la revue SQL et de l'autorisation explicite d'activation Staging.
ADMIN_STAGING_SECURITY_REVIEW=
# Développement local Windows : moteur Linux Docker certifié, après revue Staging.
ADMIN_STAGING_LOCAL_ENGINE_ENABLED=false
