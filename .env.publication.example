# Preparation only. No transfer route is activated by this example.
# Keep the existing Staging Auth and security gates from docs/auth.md.
ADMIN_PUBLICATION_ENABLED=false
ADMIN_PUBLICATION_SECURITY_REVIEW=
ADMIN_PUBLICATION_TARGET_PROJECT_REF=
# Private, distinct LOGIN credentials; never use NEXT_PUBLIC_* for these.
ADMIN_PUBLICATION_SOURCE_PG_URL=
ADMIN_PUBLICATION_TARGET_PG_URL=
# Independent 32-byte secret encoded as 64 hex characters; server only.
# Required for signing a prepared diff; changing it invalidates confirmations.
ADMIN_PUBLICATION_CONFIRMATION_KEY=
# Optional PEM root CA certificates, supplied securely by the operator:
# ADMIN_PUBLICATION_SOURCE_PG_CA=
# ADMIN_PUBLICATION_TARGET_PG_CA=
